# --- required for docker-compose ---
DOMAIN=practice.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- accounts ---
ALLOW_SIGNUP=false              # true = anyone can register; false = admins create users via CLI
# SESSION_TTL=720h

# ===================== video analysis pipeline =====================
# Steps run in this order: transcribe → keywords → claude. Each is enabled
# when configured; ANALYSIS_STEPS picks which run automatically after upload
# (admins can pick any available steps per run in the UI).
# ANALYSIS_STEPS=transcribe,keywords,claude
# ANALYSIS_LANGUAGE=ru          # ru | en — language of summaries, pose names, transcription hint

# --- step "transcribe": any OpenAI-compatible speech-to-text API ---
# Option A: self-hosted Whisper (docker compose --profile whisper up -d)
TRANSCRIBE_BASE_URL=http://whisper:8000/v1
TRANSCRIBE_MODEL=Systran/faster-whisper-small   # or Systran/faster-whisper-base (faster), -medium (better)
# Option B: OpenAI (fast, ~$0.006/min)
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_API_KEY=sk-...
# TRANSCRIBE_MODEL=whisper-1
# Option C: Groq
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=gsk_...
# TRANSCRIBE_MODEL=whisper-large-v3
#
# TRANSCRIBE_LANGUAGE=ru        # default: ANALYSIS_LANGUAGE; "auto" to detect
# TRANSCRIBE_RESPONSE_FORMAT=verbose_json   # use "json" for models without segment timestamps (e.g. gpt-4o-transcribe)
# TRANSCRIBE_CHUNK_SECONDS=1200 # audio is split into chunks of this length
# TRANSCRIBE_PROMPT=            # vocabulary hint; default lists common asana names

# --- step "keywords": built-in pose dictionary matching on the transcript (free) ---
# KEYWORDS_ENABLED=true

# --- step "claude": Claude reads transcript + frames and writes the final analysis ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high            # low | medium | high | xhigh | max
# CLAUDE_INPUTS=transcript,frames   # "transcript" only = much cheaper text-only analysis
# CLAUDE_MAX_FRAMES=90
# CLAUDE_FRAME_WIDTH=768

# ===================== admin Telegram bot (optional) =====================
# Messages admins when a video is processed / analysed, and accepts videos
# sent to it (each becomes a draft post). Create a bot with @BotFather, then
# send it /login and sign in with your website email + password.
# TELEGRAM_BOT_TOKEN=123456:ABC...
#
# The public Bot API only lets bots download files up to 20 MB. For real
# videos run the local Bot API server (docker compose --profile telegram):
# get api_id / api_hash at https://my.telegram.org, then once run
#   curl https://api.telegram.org/bot<TOKEN>/logOut
# to move the bot off the public API, and set:
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# --- uploads / processing ---
# MAX_VIDEO_MB=4096
# MAX_IMAGE_MB=20
# WORKER_CONCURRENCY=1

# --- only for running outside docker ---
# DATABASE_URL=postgres://user:pass@localhost:5432/lilya?sslmode=disable
# DATA_DIR=./data
# LISTEN_ADDR=:8080
# COOKIE_SECURE=false           # only for plain-http local development
